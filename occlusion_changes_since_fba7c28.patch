+    c = current[::8, ::8].astype(np.float32)
+    r = reference[::8, ::8].astype(np.float32)
+    c10, c90 = np.percentile(c, (10, 90))
+    r10, r90 = np.percentile(r, (10, 90))
+    if c90 - c10 < 4.0 or r90 - r10 < 4.0:
